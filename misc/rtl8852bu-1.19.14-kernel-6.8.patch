diff -ruN a/include/osdep_service_linux.h b/include/osdep_service_linux.h
--- a/include/osdep_service_linux.h	2026-06-25 21:37:33.192000000 +0000
+++ b/include/osdep_service_linux.h	2026-06-25 21:37:33.284000000 +0000
@@ -16,6 +16,15 @@
 #define __OSDEP_LINUX_SERVICE_H_
 
 #include <linux/version.h>
+
+/* kernel 6.8 removed strlcpy() (kept only strscpy()); the few call sites in
+ * this driver ignore the return value, so alias it back. -- G1 carrier patch */
+#if (LINUX_VERSION_CODE >= KERNEL_VERSION(6, 8, 0))
+#include <linux/string.h>
+#ifndef strlcpy
+#define strlcpy(dst, src, size) strscpy((dst), (src), (size))
+#endif
+#endif
 #include <linux/spinlock.h>
 #include <linux/compiler.h>
 #include <linux/kernel.h>
