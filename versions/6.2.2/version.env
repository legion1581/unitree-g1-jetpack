# JetPack 6.2.2 / L4T 36.5.0 — Unitree Go2 dock (Orin NX/Nano p3767 on p3768)
# Sourced by go2_custom_jetpack.sh. All version-specific knobs live here; adding a
# new JetPack = copy this folder to versions/<new>/ and adjust.

JP_VER="6.2.2"
L4T_VER="36.5.0"
KVER="5.15.185-tegra"            # running kernel (for /lib/modules/<KVER>/ paths)

# --- NVIDIA CDN tarballs (Driver Package + sample rootfs) ------------------------
BSP_URL="https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v5.0/release/jetson_linux_r36.5.0_aarch64.tbz2"
RFS_URL="https://developer.nvidia.com/downloads/embedded/l4t/r36_release_v5.0/release/tegra_linux_sample-root-filesystem_r36.5.0_aarch64.tbz2"

# --- board / flash ---------------------------------------------------------------
BOARD_CONF="jetson-orin-nano-devkit"   # devkit conf; flash auto-picks DTB by module SKU
# --super (flash only): NVIDIA's "Super" board config. Flashes the -nv-super kernel DTB
# + super BPMP DTB, whose compatible (…-super) makes nvpower.sh pick the MAXN_SUPER
# nvpmodel conf (adds MAXN_SUPER + a 40W mode, default 40W). TOPS boost: Orin NX 16GB
# 100->157, Orin Nano 8GB 40->67. Draws much more power — confirm the Go2 rail + cooling.
BOARD_CONF_SUPER="jetson-orin-nano-devkit-super"
ROOT_DEV="nvme0n1p1"
# initrd-flash configs (R36 paths)
NVME_XML="tools/kernel_flash/flash_l4t_t234_nvme.xml"
QSPI_CFG="bootloader/generic/cfg/flash_t234_qspi.xml"

# --- patched kernel DTBs shipped in dtb/ (copied over the stock ones) ------------
# All installed every build; flash-time board conf + module SKU select which is used:
# NX (0000) vs Nano (0003), standard (-nv) vs --super (-nv-super).
DTBS="tegra234-p3768-0000+p3767-0000-nv.dtb tegra234-p3768-0000+p3767-0000-nv-super.dtb tegra234-p3768-0000+p3767-0003-nv.dtb tegra234-p3768-0000+p3767-0003-nv-super.dtb"

# --- rootfs customization --------------------------------------------------------
USERNAME="unitree"
PASSWORD="123"
HOSTNAME="ubuntu"                # device hostname (NVIDIA default would be tegra-ubuntu)
AUTOLOGIN="yes"                  # yes|true -> auto-login the user on console/serial
NET_IFACE="enP8p1s0"             # onboard wired NIC on this SoM/carrier
STATIC_IP="192.168.123.18/24"    # point-to-point wired LAN; no gateway/DNS (carrier has no WiFi)
GATEWAY=""                       # set only if this NIC should be the default route
DNS=""
