# JetPack 5.1.6 / L4T 35.6.4 — Unitree G1 custom carrier (Orin NX p3767 on p3768)
# Sourced by go2_custom_jetpack.sh. All version-specific knobs live here.

JP_VER="5.1.6"
L4T_VER="35.6.4"
KVER="5.10.216-tegra"            # running kernel (for /lib/modules/<KVER>/ paths)

# --- NVIDIA CDN tarballs (Driver Package + sample rootfs) ------------------------
BSP_URL="https://developer.nvidia.com/downloads/embedded/l4t/r35_release_v6.4/release/jetson_linux_r35.6.4_aarch64.tbz2"
RFS_URL="https://developer.nvidia.com/downloads/embedded/l4t/r35_release_v6.4/release/tegra_linux_sample-root-filesystem_r35.6.4_aarch64.tbz2"

# --- board / flash ---------------------------------------------------------------
BOARD_CONF="jetson-orin-nano-devkit"   # Unitree NX flashes with the devkit conf
ROOT_DEV="nvme0n1p1"
# initrd-flash configs (R35 paths — note: bootloader/t186ref/cfg, not generic/cfg)
NVME_XML="tools/kernel_flash/flash_l4t_t234_nvme.xml"
QSPI_CFG="bootloader/t186ref/cfg/flash_t234_qspi.xml"

# --- patched kernel DTB shipped in dtb/ (copied over the stock one) ---------------
DTBS="tegra234-p3767-0000-p3768-0000-a0.dtb"

# --- rootfs customization --------------------------------------------------------
USERNAME="unitree"
PASSWORD="123"
HOSTNAME="ubuntu"                # device hostname (NVIDIA default would be tegra-ubuntu)
AUTOLOGIN="yes"                  # yes|true -> auto-login the user on console/serial
NET_IFACE="eth0"                 # onboard wired NIC. The image boots with net.ifnames=0
                                 # (kernel cmdline), so the PCIe RTL8168 is eth0 — NOT the
                                 # predictable name enP8p1s0. Binding the NM keyfile to
                                 # enP8p1s0 leaves the static IP unapplied.
STATIC_IP="192.168.123.18/24"    # point-to-point wired LAN; no gateway/DNS (carrier has no WiFi)
GATEWAY=""                       # set only if this NIC should be the default route
DNS=""
