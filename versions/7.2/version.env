# JetPack 7.2 / L4T 39.2.0 — Unitree G1 custom carrier (Orin NX p3767 on p3768)
# Sourced by g1_custom_jetpack.sh. All version-specific knobs live here.
#
# WiFi + BT verified on kernel 6.8: 8852bu.ko (WiFi) is rebuilt for 6.8 and shipped
# in modules/; BT uses the image's own rtk_btusb (v3.1) and just needs the firmware
# blobs in firmware/. See 50-rootfs-wifi-bt.sh and misc/ for the patched WiFi source.

JP_VER="7.2"
L4T_VER="39.2.0"
KVER="6.8.12-1021-tegra"         # from the BSP kernel Image; confirm on device: uname -r

# --- NVIDIA CDN tarballs (Driver Package + sample rootfs) ------------------------
BSP_URL="https://developer.nvidia.com/downloads/embedded/L4T/r39_Release_v2.0/release/Jetson_Linux_R39.2.0_aarch64.tbz2"
RFS_URL="https://developer.nvidia.com/downloads/embedded/L4T/r39_Release_v2.0/release/Tegra_Linux_Sample-Root-Filesystem_R39.2.0_aarch64.tbz2"

# --- board / flash ---------------------------------------------------------------
BOARD_CONF="jetson-orin-nano-devkit"   # confirmed present in R39; Unitree NX flashes with it
# --super (flash only): NVIDIA's "Super" board config. Flashes the -nv-super kernel DTB
# + super BPMP DTB, whose compatible (…-super) makes nvpower.sh pick the MAXN_SUPER
# nvpmodel conf (adds MAXN_SUPER + a 40W mode, default 40W). Orin NX draws much more
# power here — confirm the G1 carrier rail + cooling before trusting it in the robot.
BOARD_CONF_SUPER="jetson-orin-nano-devkit-super"
ROOT_DEV="nvme0n1p1"
# initrd-flash configs (R39 = R36-style paths: bootloader/generic/cfg)
NVME_XML="tools/kernel_flash/flash_l4t_t234_nvme.xml"
QSPI_CFG="bootloader/generic/cfg/flash_t234_qspi.xml"

# --- patched kernel DTBs shipped in dtb/ (copied over the stock ones) -------------
# Both are installed every build; the flash-time board config selects which one is
# used — standard board conf -> -nv.dtb, --super -> -nv-super.dtb.
DTBS="tegra234-p3768-0000+p3767-0000-nv.dtb tegra234-p3768-0000+p3767-0000-nv-super.dtb"

# --- rootfs customization --------------------------------------------------------
USERNAME="unitree"
PASSWORD="123"
HOSTNAME="ubuntu"                # device hostname (NVIDIA default would be tegra-ubuntu)
AUTOLOGIN="yes"                  # yes|true -> auto-login the user on console/serial
NET_IFACE="eth0"                 # 80-rootfs-ifnames.sh renames the wired r8168 NIC to eth0 via a
                                 # systemd .link (and the RTL8852BU WiFi to wlan0). Verified on 7.2.
STATIC_IP="192.168.123.164/24"   # point-to-point LAN; no gateway/DNS (internet is via WiFi)
GATEWAY=""                       # set only if this NIC should be the default route
DNS=""

# --- Unitree PC4 base stack (fetched at build; installed by 70-rootfs-unitree-base.sh) --------
# Vendor g1plus_pc4_unitree_install bootstrap from Unitree's CDN = master_service + ota_pipe +
# unitree_patch 1.0.0.2. Same artifact for every JetPack (aarch64, version-independent). The hash
# is the zip ENVELOPE of the current CDN artifact; Unitree occasionally re-zips identical content,
# so a mismatch means "re-verify contents, then refresh this pin", not necessarily a real change.
# (Empty UNITREE_INSTALL_SHA256 -> fetch_verify downloads but only warns.)
UNITREE_INSTALL_URL="https://oss-global-cdn.unitree.com/static/ad3297c5c9bb40368c3e0c9febefa375.zip"
UNITREE_INSTALL_SHA256="9bb545ba6b90d4477843044c780d4646fb8a543467082ae910fc83d598962765"

# --- NVIDIA L4T GStreamer plugins (baked from a pinned .deb by 72-rootfs-gstreamer.sh) --------
# nvv4l2h264enc / nvvidconv / nvjpegenc for video_hub's HW pipeline. We bake the exact .deb (from
# NVIDIA's jetson apt repo, r39.2 common) instead of `apt install` so the build is reproducible and
# needs no build-time apt run. The package's deps are all base Ubuntu libs already in the rootfs
# (libdrm2/libegl1/libgles2/libglib2.0-0t64/…), so dpkg -i resolves with no apt. Refresh the pin
# when the L4T point release changes: `apt-cache show nvidia-l4t-gstreamer` on the device gives
# Filename + SHA256 (URL = <repo base>/<Filename>).
NVIDIA_GST_DEB_URL="https://repo.download.nvidia.com/jetson/common/pool/main/n/nvidia-l4t-gstreamer/nvidia-l4t-gstreamer_39.2.0-20260601141651_arm64.deb"
NVIDIA_GST_DEB_SHA256="008c8c2821be7fe8d4e5d8f41d1cebd38801e3dddf7912aeaf63da22a6cd7482"
