# Repo-level defaults for g1_custom_jetpack.sh (committed; not secrets).
# Override per-run with -j <ver> / --jetpack <ver> or the G1_JP env var.

# JetPack used when -j is omitted for  init / flash / clean.
DEFAULT_JP="6.2.2"

# JetPack whose BSP initrd performs  backup / restore  (these are device-state
# operations; they just need a working recovery initrd, so one BSP serves all).
BACKUP_JP="6.2.2"
